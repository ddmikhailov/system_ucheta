# development — включает Swagger (/docs, /openapi.json); production
# (по умолчанию, если не задано) — выключает их. См. README/TODO.md.
ENVIRONMENT=development

DB_HOST=db
DB_PORT=3306
DB_USER=kait20
DB_PASSWORD=change-me
DB_NAME=kait20

# Обязателен, случайная строка не короче 32 символов — сгенерировать можно
# командой: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

CORS_ORIGINS=["http://localhost:5173"]

# Telegram-бот и планировщик — оставьте TELEGRAM_BOT_TOKEN пустым, чтобы их
# отключить (веб-платформа при этом работает как обычно). По умолчанию бот и
# планировщик встроены в тот же процесс, что и API (EMBED_WORKERS=true) —
# отдельные bot/main.py и scheduler/main.py нужны, только если сознательно
# разносите их по разным контейнерам (тогда EMBED_WORKERS=false здесь).
EMBED_WORKERS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
NOTIFICATION_TIMEZONE=Europe/Moscow
# Публичный адрес — тот же самый домен, на котором открывается сама платформа
# (frontend и API теперь отдаются одним процессом с одного origin).
WEB_APP_BASE_URL=http://localhost:8000
