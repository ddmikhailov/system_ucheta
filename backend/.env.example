# development — включает Swagger (/docs, /openapi.json); production
# (по умолчанию, если не задано) — выключает их. См. README/TODO.md.
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=kait20
DB_PASSWORD=change-me
DB_NAME=kait20

# Обязателен, случайная строка не короче 32 символов — сгенерировать можно
# командой: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

CORS_ORIGINS=["http://localhost:5173"]

# Часовой пояс колледжа: по нему считаются «сегодня» (можно ли править день,
# сдан ли вовремя) и время сдачи в разборе дисциплины кураторов.
NOTIFICATION_TIMEZONE=Europe/Moscow

# Мониторинг ошибок (Sentry) — оставьте пустым, чтобы выключить (по
# умолчанию). Завести проект на sentry.io и вписать сюда его DSN.
SENTRY_DSN=
